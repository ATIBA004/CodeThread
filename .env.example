# PostgreSQL connection string (used by the app and optional local tooling)
DATABASE_URL=postgresql://qa:qa@localhost:5432/qa

# Iron-session: minimum 32 random characters (generate with openssl rand -hex 32)
SESSION_SECRET=

# Directory for uploaded images (must be writable). Defaults to ./data/uploads
UPLOAD_DIR=

# Node environment
NODE_ENV=development

# Set to "true" only when the site is served over HTTPS (e.g. production behind TLS).
# Leave unset or "false" for http://localhost or Docker without HTTPS.
SESSION_COOKIE_SECURE=
